{
  "name": "consumer-dispute-evidence-store",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "db:migrate": "node --experimental-sqlite --import tsx scripts/migrate.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite --import tsx src/server.ts",
    "dev": "node --experimental-sqlite --import tsx src/server.ts",
    "test": "node --experimental-sqlite --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "fastify": "5.12.5",
    "kysely": "0.28.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.3.1",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
